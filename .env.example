# ---------------------------------------------------------------------------
# Copy this file to `.env` and adjust. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# SQLite database location (":memory:" for an ephemeral in-process database)
DB_PATH=./data/taskboard.sqlite

# Comma-separated list of allowed CORS origins ("*" to allow any origin)
CORS_ORIGIN=*

# --- Secrets -----------------------------------------------------------------
# Generate with:  node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production. In development a random secret is generated at boot,
# which means restarting the server invalidates all previously issued tokens.
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Rate limiting (login endpoint, per IP) ---------------------------------
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# --- Bootstrap admin (optional) ---------------------------------------------
# Created once at startup when the users table is empty. Omit to skip.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Platform Admin